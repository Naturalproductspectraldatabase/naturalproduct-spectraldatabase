# Option 1: single shared login
NPDB_ACCESS_USERNAME = "approved_user"
NPDB_ACCESS_PASSWORD = "change_this_password"

# Option 2: approved names with one shared password
# Username format in the app: npdb_<name>
# Example: npdb_tyas
# NPDB_APPROVED_PASSWORD = "change_this_shared_password"
# NPDB_APPROVED_NAMES = ["tyas", "sensei", "labmate1"]

# Option 3: approved user list
# Uncomment this block if you want one account per approved person.
# [[NPDB_APPROVED_USERS]]
# username = "tyas"
# password = "change_this_password"
# role = "admin"
#
# [[NPDB_APPROVED_USERS]]
# username = "guest_01"
# password = "change_this_password"
# role = "viewer"

# Optional Supabase secrets for cloud mode
# SUPABASE_URL = "https://your-project.supabase.co"
# SUPABASE_ANON_KEY = "your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY = "your-service-role-key"

# Optional performance mode for desktop development.
# Use "local" when database/nmr.db is your fast read mirror.
# Use "supabase" on Streamlit Cloud if the deployed app should read live cloud data.
# NPDB_READ_BACKEND = "local"
