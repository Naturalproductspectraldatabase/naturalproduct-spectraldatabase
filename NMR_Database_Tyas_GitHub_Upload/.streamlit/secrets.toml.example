# Streamlit secrets template for NPDB.
# Keep real values only in Streamlit Cloud secrets or local .streamlit/secrets.toml.
# Never commit plaintext passwords, Supabase keys, or generated credential CSV files.

# Supabase cloud mode. Put top-level keys before [[NPDB_APPROVED_USERS]] blocks.
# SUPABASE_URL = "https://your-project.supabase.co"
# SUPABASE_ANON_KEY = "your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY = "your-service-role-key"
# NPDB_READ_BACKEND = "supabase"

# Recommended access model: one hashed account per approved person.
# Generate blocks with:
# python scripts/generate_npdb_credentials.py \
#   --owner-password "change_this_owner_password" \
#   --viewer-count 100 \
#   --first-viewer-username npdb_tjomori \
#   --first-viewer-password "change_this_viewer_password" \
#   --plain-report data/exports/credentials/npdb_user_credentials_private.csv
#
# Keep the private CSV local only. Users type the plaintext password from that
# private CSV; Streamlit secrets store only the password_hash value.
#
# [[NPDB_APPROVED_USERS]]
# username = "npdb_tyas"
# password_hash = "pbkdf2_sha256$390000$example_salt$example_digest"
# role = "owner_editor"
#
# [[NPDB_APPROVED_USERS]]
# username = "npdb_tjomori"
# password_hash = "pbkdf2_sha256$390000$example_salt$example_digest"
# role = "viewer"
